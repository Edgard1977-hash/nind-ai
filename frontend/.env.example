# Copy to frontend/.env for local `yarn start`.
# Leave empty to call the API on the same origin (CRA dev proxy → localhost:8000,
# or nginx in docker-compose). Set a full origin when the API is hosted elsewhere.
# No trailing slash.
REACT_APP_BACKEND_URL=

# Google sign-in does not need a client id in the browser. The backend owns
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET and the authorization-code redirect.
