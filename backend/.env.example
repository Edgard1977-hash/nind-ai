# Copy to backend/.env and fill in the values you have. The API starts with these
# defaults; generation and Google login stay disabled until the matching keys exist.

# MongoDB. Local process: mongodb://localhost:27017
# docker compose --profile local-mongo: mongodb://mongo:27017
# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=nind

# Comma-separated browser origins allowed to call the API with cookies.
# Do not use "*": credentialed requests require an explicit origin.
CORS_ORIGINS=http://localhost:3000
# Public URL of this API, no trailing slash. Google OAuth redirect is
# {PUBLIC_BACKEND_URL}/api/auth/google/callback unless GOOGLE_REDIRECT_URI is set.
PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Session signing. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_DAYS=7
# Cookie flags. Use secure=true and samesite=none only on HTTPS when the
# frontend and API are on different sites. Local HTTP should stay lax/false.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# New accounts start with this many credits. One generation costs GENERATION_CREDIT_COST.
SIGNUP_CREDITS=100
GENERATION_CREDIT_COST=10

# Google OAuth (authorization code). Create an OAuth client (Web) in Google Cloud
# Console → APIs & Services → Credentials. Authorized redirect URI:
#   http://localhost:8000/api/auth/google/callback
# (and the same path on your public API host).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override of the redirect URI registered in Google Cloud.
GOOGLE_REDIRECT_URI=

# Text LLM. OpenRouter is an OpenAI-compatible API.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional attribution headers OpenRouter asks for.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=nind

# Image generation ("Nano Banana"). Prefer a Gemini API key from Google AI Studio:
# https://aistudio.google.com/apikey
# Model default is gemini-2.5-flash-image. If GEMINI_API_KEY is empty, images
# fall back to OpenRouter using OPENROUTER_API_KEY.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Speech-to-text. Any OpenAI-compatible Whisper endpoint.
# OpenAI:  STT_BASE_URL=https://api.openai.com/v1          STT_MODEL=whisper-1
# Groq:    STT_BASE_URL=https://api.groq.com/openai/v1     STT_MODEL=whisper-large-v3
# Groq keys: https://console.groq.com/keys
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# Text-to-speech for Basic-mode voiceover.
# openai/gpt-audio-mini is not on /audio/speech. OpenRouter serves it as a
# streaming chat completion (modalities text+audio). With only
# OPENROUTER_API_KEY set, nind uses that path and TTS_MODEL below.
# Voices: marin (default, natural), cedar, alloy, nova, shimmer, coral,
# ash, echo, onyx. The app also exposes these in the Basic voice picker.
TTS_PROVIDER=openrouter
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=openai/gpt-audio-mini
TTS_VOICE=marin
TTS_AUDIO_FORMAT=wav
# Optional. Set TTS_PROVIDER=speech and point TTS_BASE_URL at an
# OpenAI-compatible /audio/speech host (and set TTS_MODEL=tts-1) to use a
# dedicated speech key instead of OpenRouter chat-audio.
# TTS_API_KEY falls back to OPENAI_API_KEY when empty.
TTS_API_KEY=
OPENAI_API_KEY=
# Quiet background bed under the voiceover. Generated locally with ffmpeg
# (filtered noise and two soft tones). No extra music vendor. Set to 0 to
# ship voice, motion, and captions without the bed.
BASIC_AMBIENT_BED=1

# Video generation for Enhanced mode. Leave empty until a later release wires
# Kling, Wan, Veo, or an aggregator. Setting a name today still returns
# "coming soon / provider not configured".
VIDEO_PROVIDER=

# Optional filesystem overrides. Defaults are directories next to the backend code.
# NIND_BACKEND_DIR=
# NIND_UPLOADS_DIR=
# NIND_WORK_DIR=

# Set to 1 only inside a privileged container if ffmpeg is missing at boot.
AUTO_INSTALL_DEPS=0
